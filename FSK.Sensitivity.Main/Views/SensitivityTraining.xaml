<UserControl x:Class="FSK.Sensitivity.Main.Views.SensitivityTraining"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views"
              xmlns:cvt="clr-namespace:FSK.Sensitivity.Main.Converters"
            xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:lcext="clr-namespace:FSK.Sensitivity.Main.Controls.Extend"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True" 
             mc:Ignorable="d" 
             d:DesignHeight="1024" d:DesignWidth="1980">
    <UserControl.Resources>
        <cvt:BackgroundConverter x:Key="BackgroundConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <SolidColorBrush Color="#66FFFFFF" x:Key="BordelBackGround"></SolidColorBrush>
        <Style x:Key="txtTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.ConfigTitle}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"></Setter>
            <Setter Property="Opacity" Value="0.8"></Setter>
        </Style>
        <Style x:Key="txtValue" TargetType="TextBlock" BasedOn="{StaticResource txtTitle}">
            <Setter Property="Opacity" Value="1"></Setter>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="txtParam" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Headline}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>

            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource ConfigParamBorderStyle}" >

                <Grid Margin="10" DataContext="{Binding CheckUserModel}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.5*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="0.5*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0"  Grid.Row="1" Style="{StaticResource txtTitle}">
                            <Run Text="项目"/>
                            <Run Text="："/>
                    </TextBlock>
                    <TextBlock  Grid.Column="1"  Grid.Row="1" Text="对比敏感度" Grid.ColumnSpan="4" Style="{StaticResource txtValue}"/>
                    
                    <TextBlock Grid.Column="0" Grid.Row="2"   Style="{StaticResource txtTitle}">
<Run Text="姓名"/>
<Run Text="："/>
                    </TextBlock>
                    <TextBlock  Grid.Column="1" Grid.Row="2" Text="{Binding Name}"  TextWrapping="WrapWithOverflow" Style="{StaticResource txtValue}"/>

                    <TextBlock Grid.Column="2"  Grid.Row="2" Style="{StaticResource txtTitle}">
        <Run Text="瞳距"/>
        <Run Text="："/>
                    </TextBlock>
                    <TextBlock  Grid.Column="3"  Grid.Row="2" Text="{Binding PD}"  Style="{StaticResource txtValue}"/>
                    <TextBlock Grid.Column="4"  Grid.Row="2" Style="{StaticResource txtTitle}">
<Run Text="炫光"/>
<Run Text="："/>
                    </TextBlock>
                    <TextBlock  Grid.Column="5"  Grid.Row="2" Text="{Binding LightDesc}"  Style="{StaticResource txtValue}"/>
                    <TextBlock  Grid.Column="0" Grid.Row="3"  Style="{StaticResource txtTitle}">
<Run Text="年龄"/>
<Run Text="："/>
                    </TextBlock>
                    <TextBlock    Grid.Column="1"  Grid.Row="3"  Text="{Binding Age}"  Style="{StaticResource txtValue}"/>

                    <TextBlock  Grid.Row="3" Grid.Column="2"  Style="{StaticResource txtTitle}">
<Run Text="性别"/>
<Run Text="："/>
                    </TextBlock>
                    <TextBlock   Grid.Row="3" Grid.Column="3" Text="{Binding Gender}"  Style="{StaticResource txtValue}"/>
                    <TextBlock  Grid.Row="3" Grid.Column="4"  Style="{StaticResource txtTitle}">
<Run Text="日夜"/>
<Run Text="："/>
                    </TextBlock>
                    <TextBlock   Grid.Row="3" Grid.Column="5" Text="{Binding DayNigthDesc}"  Style="{StaticResource txtValue}"/>

                </Grid>
                
            </Border>
            <Border Grid.Column="1" Style="{DynamicResource TrainSignBorderStyle}"  Background="White" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="1.2*"/>
                    </Grid.RowDefinitions>


                    <Border CornerRadius="4" Margin="30,0"  Visibility="{Binding ShowSign}" >
                        <Border.Background>
                            <ImageBrush Stretch="Fill"  RenderOptions.BitmapScalingMode="HighQuality" ImageSource="{Binding SignPath,Converter={StaticResource BackgroundConverter}}"></ImageBrush>
                        </Border.Background>
                    </Border>
                    <Grid Grid.Row="1" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <RadioButton lcext:ButtonClickAttach.IsButtonClick="{Binding IsClicked}"  HorizontalContentAlignment="Center"  VerticalContentAlignment="Top"  GroupName="SelectSign"  IsChecked="{Binding SignSelectIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=1}" Content="1"   Style="{StaticResource SignToggleDisplayButtonBaseStyle}"/>
                            <RadioButton lcext:ButtonClickAttach.IsButtonClick="{Binding IsClicked}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" GroupName="SelectSign"  IsChecked="{Binding SignSelectIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=2}" Content="2"   Style="{StaticResource SignToggleDisplayButtonBaseStyle}"/>
                            <RadioButton  lcext:ButtonClickAttach.IsButtonClick="{Binding IsClicked}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" GroupName="SelectSign"  IsChecked="{Binding SignSelectIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=3}" Content="3"   Style="{StaticResource SignToggleDisplayButtonBaseStyle}"/>
                            <RadioButton  lcext:ButtonClickAttach.IsButtonClick="{Binding IsClicked}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" GroupName="SelectSign"  IsChecked="{Binding SignSelectIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=4}" Content="4"   Style="{StaticResource SignToggleDisplayButtonBaseStyle}"/>
                            <RadioButton  lcext:ButtonClickAttach.IsButtonClick="{Binding IsClicked}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" GroupName="SelectSign"  IsChecked="{Binding SignSelectIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=5}" Content="5"   Style="{StaticResource SignToggleDisplayButtonBaseStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <RadioButton  lcext:ButtonClickAttach.IsButtonClick="{Binding IsClicked}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" GroupName="SelectSign"  IsChecked="{Binding SignSelectIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=6}" Content="6"   Style="{StaticResource SignToggleDisplayButtonBaseStyle}"/>
                            <RadioButton  lcext:ButtonClickAttach.IsButtonClick="{Binding IsClicked}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" GroupName="SelectSign"  IsChecked="{Binding SignSelectIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=7}" Content="7"   Style="{StaticResource SignToggleDisplayButtonBaseStyle}"/>
                            <RadioButton  lcext:ButtonClickAttach.IsButtonClick="{Binding IsClicked}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" GroupName="SelectSign"  IsChecked="{Binding SignSelectIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=8}" Content="8"   Style="{StaticResource SignToggleDisplayButtonBaseStyle}"/>
                            <RadioButton  lcext:ButtonClickAttach.IsButtonClick="{Binding IsClicked}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" GroupName="SelectSign"  IsChecked="{Binding SignSelectIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=9}" Content="9"   Style="{StaticResource SignToggleDisplayButtonBaseStyle}"/>
                            
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Column="2" Margin="0,5" DataContext="{Binding ArrowButtonStauts}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button   lcext:ButtonActiveAttach.IsButtonActive="{Binding SaveButtonStatus}"  hc:IconElement.Geometry="{StaticResource RingGeometry}"   Style="{DynamicResource ArrowButtontwinkle}" RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="180"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>

                </Button>
                <Button Grid.Column="2" Padding="3" lcext:ButtonActiveAttach.IsButtonActive="{Binding TriggerButtonStatus}" hc:IconElement.Geometry="{StaticResource TriangleGeometry}"  Style="{DynamicResource ArrowButtontwinkle}"  RenderTransformOrigin="0.5,0.5">
                    
                </Button>
                <Button  Grid.Column="1"  lcext:ButtonActiveAttach.IsButtonActive="{Binding UpButtonStatus}" hc:IconElement.Geometry="{StaticResource ArrowGeometry}"  Style="{DynamicResource ArrowButtontwinkle}" RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="180"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>

                </Button>
                <Button  Grid.Row="1" lcext:ButtonActiveAttach.IsButtonActive="{Binding LeftButtonStatus}"  hc:IconElement.Geometry="{StaticResource ArrowGeometry}"    Style="{DynamicResource ArrowButtontwinkle}" RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="90"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>

                </Button>
                <Button  Grid.Row="1" Grid.Column="2" lcext:ButtonActiveAttach.IsButtonActive="{Binding RightButtonStatus}"  hc:IconElement.Geometry="{StaticResource ArrowGeometry}"    Style="{DynamicResource ArrowButtontwinkle}" RenderTransformOrigin="0.5,0.5" >
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="-90"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>

                </Button>
                <Button  Grid.Row="2" Grid.Column="1" lcext:ButtonActiveAttach.IsButtonActive="{Binding DownButtonStatus}"  hc:IconElement.Geometry="{StaticResource ArrowGeometry}"  Style="{DynamicResource ArrowButtontwinkle}"  RenderTransformOrigin="0.5,0.5">

                </Button>
                <Button  Grid.Row="2"    hc:IconElement.Geometry="{StaticResource RotateLeftGeometry}"  Style="{DynamicResource ArrowButton}" Command="{Binding Path=DataContext.RefreshCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" RenderTransformOrigin="0.5,0.5">

                </Button>

            </Grid>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="2">
            <Border Style="{DynamicResource ConfigParamBorderStyle}"  DataContext="{Binding LeftCSFTrainModel}">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5*"/>
                    </Grid.RowDefinitions>
                    <Border BorderThickness="0,0,0,3" BorderBrush="#FF999999">
                        <TextBlock FontSize="{StaticResource FontSize.ConfigTitle}" Foreground="White" Opacity=".9" HorizontalAlignment="Center" VerticalAlignment="Center" >
                            <Run Text="{Binding TrainStatusText}"></Run>
                            <Run Text="："></Run>
                            <Run Text="左眼检查项目"></Run>
                        </TextBlock>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border CornerRadius="5"  Margin="0,0,10,0" >
                            <hc:GifImage  Stretch="Uniform"  Uri="/FSK.Sensitivity.Main;component/Resource/Images/leftEye.gif"  />
                        </Border>
                        <Border CornerRadius="5" Grid.Row="1"  Margin="0,10,10,0" Background="{StaticResource BordelBackGround}" >
                            <UniformGrid Rows="2" Visibility="{Binding IsTraining, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Margin="10,0" VerticalAlignment="Bottom" Foreground="White" FontSize="{StaticResource FontSize.Headline}">项目执行中...</TextBlock>
                                <ProgressBar Margin="10,0"  Style="{StaticResource ProgressBarSuccess}"  Foreground="{StaticResource MainBrush}" IsIndeterminate="True" Value="0" Maximum="100" />
                            </UniformGrid>
                        </Border>
                        <Border Grid.Column="1" Grid.RowSpan="2" CornerRadius="5" Background="{StaticResource BordelBackGround}" Margin="10,0,0,0"  >
                            <Grid Margin="15,30" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.5*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="OS" FontSize="{StaticResource FontSize.Body}" FontWeight="Bold" Foreground="White"></TextBlock>
                                <TextBlock Grid.Row="1" Style="{StaticResource txtParam}"  >
                                    <Run Text="AT:"></Run>
                                    <Run Text="{Binding AT}"></Run>
                                    <Run Text="s"></Run>
                                </TextBlock>
                                <TextBlock Grid.Row="2"  Style="{StaticResource txtParam}">
                                    <Run Text="RT:"></Run>
                                    <Run Text="{Binding RT}"></Run>
                                    <Run Text="s"></Run>
                                </TextBlock>
                                <TextBlock Grid.Row="3"  Style="{StaticResource txtParam}">
    <Run Text="VA:"></Run>
    <Run Text="{Binding VAValueText}"></Run>
                                </TextBlock>
                                <TextBlock Grid.Row="4"  Style="{StaticResource txtParam}">
<Run Text="距离:"></Run>
<Run Text="{Binding DistanceText}"></Run>
<Run Text="m"></Run>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                    

                </Grid>
                
            </Border>
            <Border Style="{DynamicResource ConfigParamBorderStyle}"  DataContext="{Binding RightCSFTrainModel}">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5*"/>
                    </Grid.RowDefinitions>
                    <Border BorderThickness="0,0,0,3" BorderBrush="#FF999999">
                        <TextBlock FontSize="{StaticResource FontSize.ConfigTitle}" Foreground="White" Opacity=".9"  HorizontalAlignment="Center" VerticalAlignment="Center" >
                            <Run Text="{Binding TrainStatusText}"></Run>
                            <Run Text="："></Run>
                            <Run Text="右眼检查项目"></Run>
                        </TextBlock>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border CornerRadius="5"  Margin="0,0,10,0" >
                            <hc:GifImage  Stretch="Uniform"  Uri="/FSK.Sensitivity.Main;component/Resource/Images/rightEye.gif"  />
                        </Border>
                        <Border CornerRadius="5" Grid.Row="1"  Margin="0,20,10,0" Background="{StaticResource BordelBackGround}" >
                            <UniformGrid Rows="2" Visibility="{Binding IsTraining, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Margin="10,0" VerticalAlignment="Bottom" Foreground="White" FontSize="16">项目执行中...</TextBlock>
                                <ProgressBar Margin="10,0" Style="{StaticResource ProgressBarSuccess}"  Foreground="{StaticResource MainBrush}" Value="0" Maximum="100" IsIndeterminate="True"/>
                            </UniformGrid>
                        </Border>
                        <Border Grid.Column="1" Grid.RowSpan="2" CornerRadius="5" Background="{StaticResource BordelBackGround}" Margin="10,0,0,0"  >
                            <Grid Margin="15,30" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.5*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="OD" FontSize="{StaticResource FontSize.Body}" FontWeight="Bold" Foreground="White"></TextBlock>
                                <TextBlock Grid.Row="1" Style="{StaticResource txtParam}">
                                    <Run Text="AT:"></Run>
                                    <Run Text="{Binding AT}"></Run>
                                    <Run Text="s"></Run>
                                </TextBlock>
                                <TextBlock Grid.Row="2"  Style="{StaticResource txtParam}">
                                    <Run Text="RT:"></Run>
                                    <Run Text="{Binding RT}"></Run>
                                    <Run Text="s"></Run>
                                </TextBlock>
                                <TextBlock Grid.Row="3"  Style="{StaticResource txtParam}">
    <Run Text="VA:"></Run>
    <Run Text="{Binding VAValueText}"></Run>
                                </TextBlock>
                                <TextBlock Grid.Row="4"  Style="{StaticResource txtParam}">
<Run Text="距离:"></Run>
<Run Text="{Binding DistanceText}"></Run>
<Run Text="m"></Run>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>


                </Grid>
            </Border>

        </UniformGrid>
    </Grid>
</UserControl>
