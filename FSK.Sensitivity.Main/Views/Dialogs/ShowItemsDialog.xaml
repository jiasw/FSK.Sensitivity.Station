<UserControl x:Class="FSK.Sensitivity.Main.Views.Dialogs.ShowItemsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views.Dialogs"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:ctl="clr-namespace:FSK.Sensitivity.Main.Controls"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             xmlns:prism="http://prismlibrary.com/"
             Loaded="UserControl_Loaded"
             d:DesignHeight="650" d:DesignWidth="800">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="WindowStyle" Value="None"></Setter>
            <Setter Property="AllowsTransparency" Value="True"></Setter>
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="Width" Value="800"></Setter>
            <Setter Property="Height" Value="550"></Setter>
            <Setter Property="Focusable" Value="True"></Setter>
        </Style>
    </prism:Dialog.WindowStyle>
    <Border CornerRadius="20" Background="{DynamicResource SecondBackGroundBrush}" BorderBrush="Gray" BorderThickness="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="120"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Title}" FontSize="36" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom"></TextBlock>
            
            <ItemsControl Grid.Row="1" Margin="10" ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button  Content="{Binding Name}"  FontSize="30" Margin="5" hc:BorderElement.CornerRadius="8" BorderThickness="2"  Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
 Path=DataContext.ItemWidth}" Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
 Path=DataContext.ItenHeight}"  Foreground="White"   Background="{DynamicResource MainBrush}">

                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="TouchDown">
                                    <prism:InvokeCommandAction 
                          Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
Path=DataContext.SelectCommand}" CommandParameter="{Binding}">

                                    </prism:InvokeCommandAction>
                                </i:EventTrigger>
                                <i:EventTrigger EventName="Click">
                                    <prism:InvokeCommandAction 
                          Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
Path=DataContext.SelectCommand}" CommandParameter="{Binding}">

                                    </prism:InvokeCommandAction>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <Button Grid.Row="2" VerticalAlignment="Center" Name="CloseButton" Content="关闭" Style="{DynamicResource SaveButton}"    Margin="90,5" Command="{Binding CloseCommand}" ></Button>
        </Grid>
        
    </Border>
    
</UserControl>
