<Window x:Class="FSK.Sensitivity.Main.Views.Dialogs.MessageWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views.Dialogs"
        mc:Ignorable="d" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="MessageWindows" MinWidth="550" 
        MinHeight="280"
        MaxWidth="600"
        MaxHeight="400"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="btnStyle" BasedOn="{StaticResource RoundedButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="110"></Setter>
            <Setter Property="Height" Value="45"></Setter>
            <Setter Property="FontSize" Value="23"></Setter>
        </Style>
        
    </Window.Resources>
    <Border Background="#F7F9FA" CornerRadius="10" BorderBrush="{StaticResource MenuSelectedBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource MainBrush}" CornerRadius="10,10,0,0">
                <Grid>
                    <TextBlock Text="{Binding Title}" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Left" 
                               Margin="15,0,0,0" 
                               Foreground="White" 
                               TextWrapping="Wrap"
                               FontWeight="Bold" 
                               FontSize="16"/>
                    <Button x:Name="CloseButton" 
                            Content="×" 
                            Width="30" 
                            Height="30" 
                            HorizontalAlignment="Right" 
                            Margin="0,0,5,0"
                            Background="Transparent" 
                            Foreground="White" 
                            FontSize="16" 
                            FontWeight="Bold"
                            Click="CloseButton_Click" 
                            BorderThickness="0"/>
                </Grid>
            </Border>
            <!-- 消息内容 -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="20,15"
                          MaxHeight="250">
                <TextBlock Text="{Binding Message}" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"
                           FontSize="24"
                           VerticalAlignment="Center"/>
            </ScrollViewer>
            <!-- 按钮区域 -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                <Button x:Name="OkButton" 
                        Content="确定" 
                        Style="{StaticResource btnStyle}"
                        Click="OkButton_Click"/>
                <Button x:Name="CancelButton" 
                        Content="取消" 
                        Width="80" 
                        Height="30" 
                        Margin="5,0" 
                        Background="#FFCCCCCC"
                        Click="CancelButton_Click" 
                        Visibility="Collapsed"/>
                <Button x:Name="YesButton" 
                        Content="是" 
                        Width="80" 
                        Height="30" 
                        Margin="5,0" 
                        Background="#FF0078D7" 
                        Foreground="White"
                        Click="YesButton_Click" 
                        Visibility="Collapsed"/>
                <Button x:Name="NoButton" 
                        Content="否" 
                        Width="80" 
                        Height="30" 
                        Margin="5,0" 
                        Background="#FFCCCCCC"
                        Click="NoButton_Click" 
                        Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
