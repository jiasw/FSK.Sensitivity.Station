<UserControl x:Class="FSK.Sensitivity.Main.Views.Dialogs.Scan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views.Dialogs"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="WindowStyle" Value="None"></Setter>
            <Setter Property="AllowsTransparency" Value="True"></Setter>
            <Setter Property="Background" Value="{DynamicResource SecondBackGroundBrush}"></Setter>
            <Setter Property="Width" Value="400"></Setter>
            <Setter Property="Height" Value="700"></Setter>
            <Setter Property="Focusable" Value="True"></Setter>
        </Style>
    </prism:Dialog.WindowStyle>
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <hc:GifImage Uri="/FSK.Sensitivity.Main;component/Resource/Images/Scan.gif"  Stretch="Uniform" />
        <!--<Image gif:AnimationBehavior.SourceUri="/FSK.Sensitivity.Main;component/Resource/Images/Scan.gif" Stretch="Uniform" />-->
        <TextBlock Grid.Row="1" Text="" TextAlignment="Center" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Title}" Margin="10,40"  HorizontalAlignment="Center" Foreground="White">
            <Run>请将二维码放置到</Run>
            <LineBreak/>
            <Run>下方扫码处</Run>
        </TextBlock>
        <Button Grid.Row="2" Content="   关   闭   " FontSize="{StaticResource FontSize.Title}" Width="200" Margin="10,10,10,40" Command="{Binding CloseCommand}" Style="{DynamicResource NavButton}"  />
    </Grid>
</UserControl>
