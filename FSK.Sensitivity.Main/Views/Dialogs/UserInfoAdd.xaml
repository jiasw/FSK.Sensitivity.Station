<UserControl x:Class="FSK.Sensitivity.Main.Views.Dialogs.UserInfoAdd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views.Dialogs"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="textblockTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource MainBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,15,20,15"></Setter>
        </Style>
        <Style x:Key="textboxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxExtend}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MainBrush}" />
            <Setter Property="Width" Value="250"></Setter>
            <Setter Property="Margin" Value="10,5"></Setter>
            <Setter Property="Height" Value="40"></Setter>
        </Style>
        <Style x:Key="comboboxStyle" TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MainBrush}" />
            <Setter Property="Margin" Value="10,5"></Setter>
            <Setter Property="Width" Value="250"></Setter>
            <Setter Property="Height" Value="40"></Setter>
        </Style>
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="WindowStyle" Value="None"></Setter>
            <Setter Property="AllowsTransparency" Value="True"></Setter>
            <Setter Property="Width" Value="550"></Setter>
            <Setter Property="SizeToContent" Value="Height"/>
            <Setter Property="Background" Value="Transparent"></Setter>
        </Style>
    </prism:Dialog.WindowStyle>
    <Border CornerRadius="10" Background="{DynamicResource DarkDefaultBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2">
        <StackPanel >
            <Button Margin="5" Width="60" Height="60" hc:IconElement.Width="30" hc:IconElement.Height="30" Style="{StaticResource ButtonIcon}"  HorizontalAlignment="Right" hc:IconElement.Geometry="{StaticResource CloseGeometry}" Command="{Binding CloseCommand}"/>
            <Grid  >

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Text="人员信息" Foreground="{StaticResource MainBrush}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                <TextBlock Grid.Column="0" Grid.Row="2" Text="姓名" Style="{StaticResource textblockTitleStyle}"></TextBlock>
                <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding Name, Mode=TwoWay}" Style="{StaticResource textboxStyle}"></TextBox>
                <TextBlock Grid.Column="0" Grid.Row="3" Text="性别" Style="{StaticResource textblockTitleStyle}"></TextBlock>
                <ComboBox Grid.Column="1" Grid.Row="3" ItemsSource="{Binding Genders}" DisplayMemberPath="Description" SelectedValuePath="Value" SelectedValue="{Binding Gender, Mode=TwoWay}" Style="{StaticResource comboboxStyle}"></ComboBox>
                <TextBlock Grid.Column="0" Grid.Row="4" Text="联系电话" Style="{StaticResource textblockTitleStyle}"></TextBlock>
                <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding Phone, Mode=TwoWay}" Style="{StaticResource textboxStyle}"></TextBox>
                <TextBlock Grid.Column="0" Grid.Row="5" Text="年龄" Style="{StaticResource textblockTitleStyle}"></TextBlock>
                <TextBox Grid.Column="1" Grid.Row="5" Text="{Binding Age, Mode=TwoWay}" Style="{StaticResource textboxStyle}"></TextBox>
                <TextBlock Grid.Column="0" Grid.Row="6" Text="类型" Style="{StaticResource textblockTitleStyle}"></TextBlock>
                <ComboBox Grid.Column="1" Grid.Row="6" ItemsSource="{Binding UserTypes}" DisplayMemberPath="Description" SelectedValuePath="Value" SelectedValue="{Binding UserType, Mode=TwoWay}" Style="{StaticResource comboboxStyle}"></ComboBox>
                <Button Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2" Content="保存" FontSize="26" Width="250" Margin="0,10" Style="{StaticResource NavButton}" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding SaveCommand}" />
            </Grid>
        </StackPanel>
    </Border>


</UserControl>
