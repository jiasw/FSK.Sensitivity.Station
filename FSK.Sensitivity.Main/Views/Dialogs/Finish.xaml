<UserControl x:Class="FSK.Sensitivity.Main.Views.Dialogs.Finish"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views.Dialogs"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:keyboard="clr-namespace:Hs.KeyBoard.WPF.Behavior;assembly=Hs.KeyBoard.WPF"
        xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d"
    MinWidth="550" 
    MinHeight="280"
    MaxWidth="600"
    MaxHeight="400"
        
    Background="Transparent">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="WindowStyle" Value="None"></Setter>
            <Setter Property="AllowsTransparency" Value="True"></Setter>
            <Setter Property="Width" Value="550"></Setter>
            <Setter Property="SizeToContent" Value="Height"/>
            <Setter Property="Background" Value="Transparent"></Setter>
        </Style>
    </prism:Dialog.WindowStyle>
        <UserControl.Resources>
        <Style x:Key="btnStyle" BasedOn="{StaticResource NavButton}" TargetType="Button">
            <Setter Property="Width" Value="160"></Setter>
            <Setter Property="Height" Value="60"></Setter>

            <Setter Property="Margin" Value="30,0"></Setter>
        </Style>

    </UserControl.Resources>
    <Border Background="#F7F9FA" CornerRadius="10" BorderBrush="{StaticResource MenuSelectedBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource MainBrush}" CornerRadius="10,10,0,0">
                <Grid>
                    <TextBlock Text="检查完成" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Left" 
                           Margin="15,0,0,0" 
                           Foreground="White" 
                           FontWeight="Bold" 
                           FontSize="26"/>
                    <Button x:Name="CloseButton" 
                        Content="×" 
                        Width="30" 
                        Height="30" 
                        HorizontalAlignment="Right" 
                        Margin="0,0,5,0"
                        Background="Transparent" 
                        Foreground="White" 
                        FontSize="16" 
                        FontWeight="Bold"
                        Click="CloseButton_Click" 
                        BorderThickness="0"/>
                </Grid>
            </Border>
            
            <!-- 按钮区域 -->
            <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <Button x:Name="OkButton" 
                    Content="查看结果"  Command="{Binding ResultCommand}"
                    Style="{StaticResource btnStyle}"
                    />
                <Button x:Name="CancelButton" 
                    Content="返回" Command="{Binding BackCommand}"
                    Style="{StaticResource btnStyle}"
                     />

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
