<UserControl x:Class="FSK.Sensitivity.Main.Views.ContrastConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views"
                  xmlns:hc="https://handyorg.github.io/handycontrol"
         mc:Ignorable="d" 
         xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="758" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>

            <Style x:Key="ConfigParamTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Opacity" Value="0.7" />
            </Style>

            <Style x:Key="CheckTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="Margin" Value="10"/>
            </Style>
            <Style x:Key="ConfigParamBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SecondBackGroundBrush}" />
                <Setter Property="BorderBrush" Value="Gray" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="10" />

            </Style>
            <Style x:Key="TimeRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource RadioButtonSameAsButtonBaseStyle}" >
                <Setter Property="Width" Value="130"></Setter>
                <Setter Property="Height" Value="60"></Setter>
                <Setter Property="FontSize" Value="35"></Setter>
                <Setter Property="Margin" Value="20,5"></Setter>
                <Setter Property="hc:BorderElement.CornerRadius" Value="10"></Setter>
                <Setter Property="Background" Value="{StaticResource ThirdBackGroundBrush}"></Setter>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{StaticResource MainBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource MainBrush}"></Setter>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
       

        <Grid >

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            
            <Border Style="{DynamicResource ConfigParamBorderStyle}" Grid.Row="1"  HorizontalAlignment="Center">
                <Grid Margin="10,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="AUTO"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="检查时间(秒)" Grid.Column="1" Style="{DynamicResource CheckTitleStyle}"></TextBlock>
                    <WrapPanel HorizontalAlignment="Center" Grid.Row="1" Grid.Column="1">
                        <RadioButton GroupName="DCK_time" IsChecked="{Binding SelectedTime, Converter={StaticResource RadioButonCheckedConverter}, ConverterParameter=5}" Content="5"  Style="{StaticResource TimeRadioButtonStyle}"/>

                        <RadioButton GroupName="DCK_time" IsChecked="{Binding SelectedTime, Converter={StaticResource RadioButonCheckedConverter}, ConverterParameter=10}" Content="10"   Style="{StaticResource TimeRadioButtonStyle}"/>

                        <RadioButton GroupName="DCK_time" IsChecked="{Binding SelectedTime, Converter={StaticResource RadioButonCheckedConverter}, ConverterParameter=15}" Content="15"  Style="{StaticResource TimeRadioButtonStyle}"/>

                        <RadioButton GroupName="DCK_time" IsChecked="{Binding SelectedTime, Converter={StaticResource RadioButonCheckedConverter}, ConverterParameter=20}" Content="20" Style="{StaticResource TimeRadioButtonStyle}"/>

                        <RadioButton GroupName="DCK_time" IsChecked="{Binding SelectedTime, Converter={StaticResource RadioButonCheckedConverter}, ConverterParameter=30}" Content="30"  Style="{StaticResource TimeRadioButtonStyle}"/>

                        <RadioButton GroupName="DCK_time" IsChecked="{Binding SelectedTime, Converter={StaticResource RadioButonCheckedConverter}, ConverterParameter=50}" Content="50" Style="{StaticResource TimeRadioButtonStyle}"/>
                        
                    </WrapPanel>
                </Grid>
               
            </Border>
            
            
            
        </Grid>
        <UniformGrid Grid.Row="1" Columns="2" Margin="10"  HorizontalAlignment="Center">
            <Button Content="确认" Style="{DynamicResource btnOprateStyle}" Command="{Binding SaveCommand}" Background="{DynamicResource MainBrush}"   Margin="50,5"   ></Button>
            <Button Content="取消" Style="{DynamicResource btnOprateStyle}" Command="{Binding BackCommand}" BorderThickness="2" Background="{DynamicResource SecondBackGroundBrush}"   Margin="50,5"  ></Button>
        </UniformGrid>
    </Grid>
</UserControl>
