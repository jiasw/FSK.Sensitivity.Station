<UserControl x:Class="FSK.Sensitivity.Main.Views.NetWork"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="serialPortConfigTitle">
            <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
            <Setter Property="Margin" Value="10,5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextAlignment" Value="Right"></Setter>
            <Setter Property="HorizontalAlignment" Value="Right"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
        <Style TargetType="ComboBox" x:Key="serialPortConfigComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
            <Setter Property="Width" Value="350" />
            <Setter Property="Height" Value="65" />
            <Setter Property="FontSize" Value="30"></Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="1" Text="WIFI:" Style="{StaticResource serialPortConfigTitle}" />
        <ComboBox  Grid.Row="1" Grid.Column="1" Text="{Binding Code}" Width="350" Margin="30,20" HorizontalAlignment="Left" Height="55" FontSize="30" />
        <TextBlock Grid.Row="2" Text="密码:" Style="{StaticResource serialPortConfigTitle}" />
        <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding Name}" Width="350" Margin="30,20" HorizontalAlignment="Left" Height="55" FontSize="30" />


        <Button  Grid.Row="3" Content="连  接" FontSize="36" Height="70" Margin="30,20" Width="250" Grid.ColumnSpan="2"  Style="{StaticResource NavButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
