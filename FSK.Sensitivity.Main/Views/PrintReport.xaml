<UserControl x:Class="FSK.Sensitivity.Main.Views.PrintReport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:ctl="clr-namespace:FSK.Sensitivity.Main.Controls"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d" d:DesignWidth="1230">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"></RowDefinition>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="350"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="White" FontSize="35" VerticalAlignment="Center" Margin="20,0">
    <Run Text="ID: "></Run>
    <Run Text="{Binding Id }"></Run>
                </TextBlock>
                <TextBlock Foreground="White" FontSize="35" VerticalAlignment="Center" Margin="20,0">
                    <Run Text="姓名: "></Run>
                    <Run Text="{Binding Name}"></Run>
                </TextBlock>
                <TextBlock Foreground="White" FontSize="35" VerticalAlignment="Center" Margin="20,0">
    <Run Text="年龄: "></Run>
    <Run Text="{Binding Age}"></Run>
                </TextBlock>
                <TextBlock Foreground="White" FontSize="35" VerticalAlignment="Center" Margin="20,0">
<Run Text="检查时间: "></Run>
<Run Text="{Binding Date}"></Run>
                </TextBlock>

            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="分析" Command="{Binding ResultCommand}" Style="{DynamicResource NavButton}" hc:IconElement.Geometry="{StaticResource SearchGeometry}" hc:IconElement.Width="30" Width="120" HorizontalAlignment="Right" Margin="20,10" ></Button>
                <Button Content="打印" Style="{StaticResource NavButton}" Width="120" HorizontalAlignment="Right" Margin="10,10" ></Button>
            </StackPanel>
            
        </Grid>

        <StackPanel Grid.Row="1"  Orientation="Vertical" >
            
                <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                    <TextBlock x:Name="LoadingTextBlock" 
                   Text="加载中..." 
                    FontSize="{StaticResource FontSize.Headline}"
                   Foreground="{StaticResource MainBrush}"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                               ctl:LoadingAnimationBehavior.IsLoading="{Binding IsAnalysis}"
                   Visibility="{Binding IsAnalysis, Converter={StaticResource BoolToVisibilityConverter}}"
                               >
                     
                    </TextBlock>
                    <TextBlock Text="{Binding Result}" HorizontalAlignment="Center"  Width="1000"
VerticalAlignment="Center"  Foreground="{StaticResource MainBrush}" TextWrapping="Wrap"  FontSize="{StaticResource FontSize.Headline}" Margin="30,10">

                    </TextBlock>
                </StackPanel>
                
            
            <UniformGrid  >
                    <Border Visibility="{Binding ShowCsf}" HorizontalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding ChartsData}" Height="380" >
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"></StackPanel>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctl:ChartsCSF  ChartsTitle="{Binding Title}" MicrospurPoints="{Binding MicrospurPoints}" ShortRangePoints="{Binding ShortRangePoints}" 
MidrangePoints="{Binding MidrangePoints}" Height="380" LongRangePoints="{Binding LongRangePoints}" Margin="60,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </Border>
                    <Border HorizontalAlignment="Center" Visibility="{Binding ShowDck}">

                        <ctl:ChartsDCK Points="{Binding Points}" Background="White"  Width="450" Height="380" Margin="7,0,0,7" Grid.Row="2"  HorizontalAlignment="Left" />
                    </Border>


                </UniformGrid>
            </StackPanel>
    








    </Grid>
</UserControl>
