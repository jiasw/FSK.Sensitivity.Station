<UserControl x:Class="FSK.Sensitivity.Main.Views.SystemSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views"
                          xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                          xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:enum = "clr-namespace:FSK.Sensitivity.Core.Enums;assembly=FSK.Sensitivity.Core"
     mc:Ignorable="d" 
     xmlns:prism="http://prismlibrary.com/"
prism:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="650" d:DesignWidth="1200">
    <UserControl.Resources>
        <Style x:Key="ItemsBoder" TargetType="Border">
            <Setter Property="VerticalAlignment" Value="Stretch"></Setter>
        </Style>
        <Style x:Key="SettingButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseBaseStyle}">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource MainBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="hc:BorderElement.CornerRadius" Value="10"/>
            <Setter Property="hc:IconElement.Width" Value="30"/>
            <Setter Property="hc:IconElement.Height" Value="30"/>
            <Setter Property="Padding" Value="2,0"></Setter>
            <Setter Property="Height" Value="200"></Setter>
            <Setter Property="Width" Value="320"></Setter>
            <Setter Property="Margin" Value="30,15"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <hc:SimplePanel  >
                            <Border Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius),RelativeSource={RelativeSource TemplatedParent}}">
                                <ContentPresenter x:Name="ContentPresenterMain" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="6,0,0,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </hc:SimplePanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" TargetName="ContentPresenterMain"/>
                            </Trigger>
                            <Trigger Property="hc:IconElement.Geometry" Value="{x:Null}">
                                <Setter Property="Margin" Value="0" TargetName="ContentPresenterMain"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value=".9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value=".6"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>

        </Style>
        <Style x:Key="ItemTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"></Setter>
            <Setter Property="FontSize" Value="36"></Setter>
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>

        </Style>
        <Style x:Key="ComboBoxItem.My" BasedOn="{StaticResource ComboBoxItemBaseStyle}" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="6,10" />
            <Setter Property="Height" Value="60" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="20"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <WrapPanel Grid.Column="1" HorizontalAlignment="Center" >

            <Button  Style="{StaticResource SettingButton}" Command="{Binding StoreSettingCommand}" >

                <Border Style="{StaticResource ItemsBoder}" Background="{DynamicResource MainBrush}" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="1.5*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/FSK.Sensitivity.Main;component/Resource/Images/store.png" Margin="25,0"  VerticalAlignment="Center" HorizontalAlignment="Right"></Image>
                        <TextBlock Grid.Column="1" Text="门店信息" Style="{StaticResource ItemTitle}"></TextBlock>
                    </Grid>
                </Border>
            </Button>
            <Button  Style="{StaticResource SettingButton}" Command="{Binding UserInfoCommand}" >

                <Border Style="{StaticResource ItemsBoder}" Background="{DynamicResource MainBrush}" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="1.5*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/FSK.Sensitivity.Main;component/Resource/Images/user.png" Margin="25,0"  VerticalAlignment="Center" HorizontalAlignment="Right"></Image>
                        <TextBlock Grid.Column="1" Text="人员信息" Style="{StaticResource ItemTitle}"></TextBlock>
                    </Grid>
                </Border>
            </Button>
            <Button  Style="{StaticResource SettingButton}" Command="{Binding SerialPortSettingCommand}">
                <Border Style="{StaticResource ItemsBoder}" Background="{DynamicResource MainBrush}" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="1.5*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/FSK.Sensitivity.Main;component/Resource/Images/hardware.png" Margin="25,0"  VerticalAlignment="Center" HorizontalAlignment="Right"></Image>
                        <TextBlock Grid.Column="1" Text="硬件配置" Style="{StaticResource ItemTitle}"></TextBlock>
                    </Grid>
                </Border>

            </Button>
            <Button  Style="{StaticResource SettingButton}" Command="{Binding OpenFileSystemCommand}">
                <Border Style="{StaticResource ItemsBoder}" Background="{DynamicResource MainBrush}" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="1.5*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/FSK.Sensitivity.Main;component/Resource/Images/file.png" Margin="25,0"  VerticalAlignment="Center" HorizontalAlignment="Right"></Image>
                        <TextBlock Grid.Column="1" Text="文件系统" Style="{StaticResource ItemTitle}"></TextBlock>
                    </Grid>
                </Border>

            </Button>
            <Button  Style="{StaticResource SettingButton}" Command="{Binding RemoteSupportCommand}">
                <Border Style="{StaticResource ItemsBoder}" Background="{DynamicResource MainBrush}" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="1.5*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/FSK.Sensitivity.Main;component/Resource/Images/remote.png" Margin="25,0"  VerticalAlignment="Center" HorizontalAlignment="Right"></Image>
                        <TextBlock Grid.Column="1" Text="远程服务" Style="{StaticResource ItemTitle}"></TextBlock>
                    </Grid>
                </Border>
            </Button>


        </WrapPanel>

    </Grid>
</UserControl>
