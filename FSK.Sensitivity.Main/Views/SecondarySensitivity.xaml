<UserControl x:Class="FSK.Sensitivity.Main.Views.SecondarySensitivity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
                  xmlns:prism="http://prismlibrary.com/"
prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" Name="敏感度视标"
             d:DesignHeight="800" d:DesignWidth="1200">

   
    <Grid Background="{Binding BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.8*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>
        <TextBlock FontSize="{StaticResource subScreenhintFontSize}" Margin="80,0" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{Binding TitleColor}"   VerticalAlignment="Bottom" TextWrapping="Wrap" >
     <Run>请选择您能看清的编号最大的视标</Run>
     <LineBreak></LineBreak>
     <Run>并选择下方的按钮</Run>
        </TextBlock>

        <Border Grid.Row="1">
            <Border.Background>
                <ImageBrush RenderOptions.BitmapScalingMode="HighQuality"  Stretch="Uniform" ImageSource="{Binding SignImage}">
                    
                </ImageBrush>
            </Border.Background>
        </Border>

        <Grid Grid.Row="2"   >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=1}" Command="{Binding SelectCommand}"  Content="1"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=2}" Command="{Binding SelectCommand}" Content="2"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=3}" Command="{Binding SelectCommand}" Content="3"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=4}" Command="{Binding SelectCommand}" Content="4"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=5}" Command="{Binding SelectCommand}" Content="5"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=6}" Command="{Binding SelectCommand}" Content="6"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=7}" Command="{Binding SelectCommand}" Content="7"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=8}" Command="{Binding SelectCommand}" Content="8"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=9}" Command="{Binding SelectCommand}" Content="9"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
