<UserControl x:Class="FSK.Sensitivity.Main.Views.SensitivityConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                          xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:enum = "clr-namespace:FSK.Sensitivity.Core.Enums;assembly=FSK.Sensitivity.Core"
             xmlns:cvt="clr-namespace:FSK.Sensitivity.Main.Converters"
             xmlns:controls="clr-namespace:FSK.Sensitivity.Main.Controls"
     mc:Ignorable="d" 
     xmlns:prism="http://prismlibrary.com/"
prism:ViewModelLocator.AutoWireViewModel="True"
         d:DesignHeight="800" d:DesignWidth="1280">
    <UserControl.Resources>
        <cvt:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        
        
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="12*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <UniformGrid Grid.Column="1" Grid.Row="1" Columns="3" Rows="2"  HorizontalAlignment="Stretch" DataContext="{Binding SensitivityConfigParam}">
                <Border Style="{DynamicResource ConfigParamBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="检查时间" Style="{DynamicResource ConfigParamTitleStyle}"></TextBlock>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CheckDuration}"  VerticalAlignment="Center" FontSize="60" Foreground="White"></TextBlock>
                                <TextBlock Text="S"  FontWeight="Bold" Padding="0,0,0,5" VerticalAlignment="Bottom" FontSize="40" Margin="5,0,0,0" Foreground="White"></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{DynamicResource ConfigParamBorderStyle}">
                    <i:Interaction.Triggers>
                        <!-- 处理左键点击 -->
                        <i:EventTrigger EventName="TouchDown">
                            <i:InvokeCommandAction 
                Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
 Path=DataContext.ShowItemsDialogCommand}"
                CommandParameter="{x:Static enum:ItemsType.Distance}"/>
                        </i:EventTrigger>
                        <!-- 处理左键点击 -->
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction 
Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
 Path=DataContext.ShowItemsDialogCommand}"
CommandParameter="{x:Static enum:ItemsType.Distance}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="检查距离" Style="{DynamicResource ConfigParamTitleStyle}"></TextBlock>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CheckDistanceDisplay}"   VerticalAlignment="Center" FontSize="60" Foreground="White"></TextBlock>
                                <TextBlock Text="m"  FontWeight="Bold" Padding="0,0,0,5" VerticalAlignment="Bottom" FontSize="40" Margin="5,0,0,0" Foreground="White"></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{DynamicResource ConfigParamBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="炫光灯" Style="{DynamicResource ConfigParamTitleStyle}"></TextBlock>
                        <Grid Grid.Row="1" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" >
                                <TextBlock Text="关"  VerticalAlignment="Center" FontSize="40" Foreground="White"></TextBlock>
                                <ToggleButton IsChecked="{Binding IsLightOn, 
                    Converter={StaticResource LightStatusToBoolConverter},
                    Mode=TwoWay}" Margin="5,9" Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl},Path=DataContext.SwitchLightCommand}"  Height="60"  HorizontalAlignment="Center" Style="{StaticResource MyToggleButtonSwitchBaseStyle}" hc:VisualElement.HighlightBrush="{DynamicResource MainBrush}"/>
                                <TextBlock Text="开"  VerticalAlignment="Center" FontSize="40" Foreground="White"></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{DynamicResource ConfigParamBorderStyle}">
                    <i:Interaction.Triggers>
                        <!-- 处理左键点击 -->
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction 
Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
 Path=DataContext.ShowItemsDialogCommand}"
CommandParameter="{x:Static enum:ItemsType.Eyes}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="TouchDown">
                            <i:InvokeCommandAction 
Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
 Path=DataContext.ShowItemsDialogCommand}"
CommandParameter="{x:Static enum:ItemsType.Eyes}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="眼别" Style="{DynamicResource ConfigParamTitleStyle}"></TextBlock>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding EyesDisplay}"  VerticalAlignment="Bottom" FontSize="55"   Foreground="White"></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{DynamicResource ConfigParamBorderStyle}">
                    <i:Interaction.Triggers>
                        <!-- 处理左键点击 -->
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction 
Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
 Path=DataContext.ShowItemsDialogCommand}"
CommandParameter="{x:Static enum:ItemsType.DayTypes}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="TouchDown">
                            <i:InvokeCommandAction 
Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
 Path=DataContext.ShowItemsDialogCommand}"
CommandParameter="{x:Static enum:ItemsType.DayTypes}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="日夜选择" Style="{DynamicResource ConfigParamTitleStyle}"></TextBlock>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DayNightDisplay}"  VerticalAlignment="Bottom" FontSize="55"   Foreground="White"></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{DynamicResource ConfigParamBorderStyle}" >
                    <i:Interaction.Triggers>
                        <!-- 处理左键点击 -->
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction 
Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
 Path=DataContext.ShowItemsDialogCommand}"
CommandParameter="{x:Static enum:ItemsType.PD}"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="TouchDown">
                            <i:InvokeCommandAction 
Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl},
 Path=DataContext.ShowItemsDialogCommand}"
CommandParameter="{x:Static enum:ItemsType.PD}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="瞳距" Style="{DynamicResource ConfigParamTitleStyle}"></TextBlock>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PD}"   VerticalAlignment="Center" FontSize="60" Foreground="White"></TextBlock>
                                <TextBlock Text="mm"  FontWeight="Bold" Padding="0,0,0,5" VerticalAlignment="Bottom" FontSize="40" Margin="5,0,0,0" Foreground="White"></TextBlock>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>





            </UniformGrid>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="2" Margin="10"  HorizontalAlignment="Center">
            <Button Content="确认" Style="{DynamicResource SaveButton}"  Command="{Binding SaveCommand}"  Margin="90,5" ></Button>
            <Button Content="取消" Style="{DynamicResource CancleButton}" Command="{Binding BackCommand}" BorderThickness="2" >
                
                
            </Button>
        </UniformGrid>
        <!-- 加载层 -->
        <controls:LoadingOverlay Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" LoadingText="{Binding LoadingMessageText}" />
    </Grid>
</UserControl>
