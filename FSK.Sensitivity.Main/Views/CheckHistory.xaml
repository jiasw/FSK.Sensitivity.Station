<UserControl x:Class="FSK.Sensitivity.Main.Views.CheckHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             Name="CheckResult"
xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="DataGrid" x:Key="datagridstyle">
            
        </Style>
        <Style TargetType="DataGridRow" x:Key="datagridrowstyle">
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="60"></Setter>
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}" x:Key="ColumnHeaderStyle">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource MainBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"></Setter>
            <Setter Property="BorderBrush" Value="White"></Setter>
            <Setter Property="Height" Value="60"></Setter>
        </Style>
        <Style TargetType="{x:Type TextBlock}" x:Key="DataTextStyle">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type DataGridCell}" x:Key="DataGridCellStyle">
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="Foreground" Value="White"/>
            
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"></Setter>
            <Setter Property="BorderBrush" Value="White"></Setter>
        </Style>
        <Style TargetType="Button" x:Key="viewBtn" BasedOn="{StaticResource NormalButton}">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="Width" Value="100"></Setter>
            <Setter Property="Height" Value="45"></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"></RowDefinition>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
      
        <Grid  VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="White" FontSize="35" VerticalAlignment="Bottom" Margin="20,0">
    <Run Text="ID: "></Run>
    <Run Text="{Binding Id }"></Run>
                </TextBlock>
                <TextBlock Foreground="White" FontSize="35" VerticalAlignment="Bottom" Margin="20,0">
                    <Run Text="姓名: "></Run>
                    <Run Text="{Binding Name}"></Run>
                </TextBlock>
                <TextBlock Foreground="White" FontSize="35" VerticalAlignment="Bottom" Margin="20,0">
    <Run Text="年龄: "></Run>
    <Run Text="{Binding Age}"></Run>
                </TextBlock>
                <TextBlock Foreground="White" FontSize="35" VerticalAlignment="Bottom" Margin="20,0">
<Run Text="检查时间: "></Run>
<Run Text="{Binding Date}"></Run>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" >
                <Button Command="{Binding PrePageCommand}"  hc:IconElement.Geometry="{StaticResource LeftGeometry}" IsEnabled="{Binding Prepageenable}" hc:IconElement.Width="35" Margin="10,0" Style="{DynamicResource NavButton}" Width="60"></Button>
                <Button Command="{Binding NextPageCommand}"  hc:IconElement.Geometry="{StaticResource RightGeometry}" IsEnabled="{Binding Nextpageenable}"  hc:IconElement.Width="35"  Style="{DynamicResource NavButton}" Width="60"></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" BorderThickness="1"  CornerRadius="4,4,0,0" >
                    <StackPanel Orientation="Vertical">
                        <Border Height="65"  Background="{StaticResource MainBrush}" CornerRadius="4,4,0,0">
                            <TextBlock Foreground="White"  FontSize="25"  HorizontalAlignment="Center" VerticalAlignment="Center" Text="检查日期"  />
                        </Border>

                        <ItemsControl ItemsSource="{Binding CheckDateItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="70" BorderThickness="1,0,1,1"   BorderBrush="White" >
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="MouseLeftButtonUp">
                                                <i:InvokeCommandAction Command="{Binding DataContext.ItemClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             CommandParameter="{Binding Date}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <!-- 鼠标划过时的样式 -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource MainBrush}"/>
                                                        <Setter Property="Opacity" Value="0.9"/> 
                                                    </Trigger>
                                                </Style.Triggers>

                                            </Style>
                                        </Border.Style>
                                        <TextBlock  Foreground="White" FontSize="25"  HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Date}"  />
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <DataGrid  Grid.Column="2" SelectionMode="Single" Style="{StaticResource datagridstyle}" RowStyle="{StaticResource datagridrowstyle}"  HeadersVisibility="Column" CanUserAddRows="False" Background="Transparent"  CanUserSortColumns="False"   GridLinesVisibility="All" ItemsSource="{Binding CheckInfos}"  AutoGenerateColumns="False" >
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="检查项目" Binding="{Binding ItemName}" Width="*" IsReadOnly="True" CellStyle="{StaticResource DataGridCellStyle}" ElementStyle="{StaticResource DataTextStyle}" HeaderStyle="{StaticResource ColumnHeaderStyle}">

                        </DataGridTextColumn>
                        <DataGridTextColumn Header="检查结果" Binding="{Binding Result}" Width="4*" IsReadOnly="True" CellStyle="{StaticResource DataGridCellStyle}" ElementStyle="{StaticResource DataTextStyle}" HeaderStyle="{StaticResource ColumnHeaderStyle}">

                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="详情"  Width="*" IsReadOnly="True" CellStyle="{StaticResource DataGridCellStyle}"  HeaderStyle="{StaticResource ColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="查看" Style="{StaticResource viewBtn}" Command="{Binding DataContext.ShowDetailCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding }"></Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
            
        </Grid>
    </Grid>
</UserControl>
