<UserControl x:Class="FSK.Sensitivity.Main.Views.CheckHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="{x:Type DataGridColumnHeader}" x:Key="ColumnHeaderStyle">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource MainBrush}"/>
            <Setter Property="Padding" Value="5,15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"></Setter>
            <Setter Property="BorderBrush" Value="White"></Setter>
        </Style>
        <Style TargetType="{x:Type TextBlock}" x:Key="DataTextStyle">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type DataGridCell}" x:Key="DataGridCellStyle">
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"></Setter>
            <Setter Property="BorderBrush" Value="White"></Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"></RowDefinition>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
      
        <Grid  VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="White" FontSize="35" VerticalAlignment="Bottom" Margin="80,0">
                    <Run Text="姓名: "></Run>
                    <Run Text="张三 "></Run>
                </TextBlock>
                <TextBlock Foreground="White" FontSize="35" VerticalAlignment="Bottom" Margin="80,0">
    <Run Text="年龄: "></Run>
    <Run Text="18 "></Run>
                </TextBlock>
                <TextBlock Foreground="White" FontSize="35" VerticalAlignment="Bottom" Margin="80,0">
<Run Text="检查时间: "></Run>
<Run Text="2021-01-01 "></Run>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button  hc:IconElement.Geometry="{StaticResource LeftGeometry}" hc:IconElement.Width="35" Margin="10,0" Style="{DynamicResource NavButton}" Width="60"></Button>
                <Button  hc:IconElement.Geometry="{StaticResource RightGeometry}" hc:IconElement.Width="35"  Style="{DynamicResource NavButton}" Width="60"></Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">


            <DataGrid  SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False" Background="Transparent" Style="{DynamicResource DataGridStyle}" CanUserSortColumns="False"  Grid.Row="1" GridLinesVisibility="All" ItemsSource="{Binding CheckInfos}"  AutoGenerateColumns="False" >
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">

                        <Setter Property="Background" Value="Transparent"></Setter>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Height" Value="80"></Setter>
                       
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="检查项目" Binding="{Binding Item}" Width="*" IsReadOnly="True" CellStyle="{StaticResource DataGridCellStyle}" ElementStyle="{StaticResource DataTextStyle}" HeaderStyle="{StaticResource ColumnHeaderStyle}">

                    </DataGridTextColumn>
                    <DataGridTextColumn Header="检查结果" Binding="{Binding Result}" Width="4*" IsReadOnly="True" CellStyle="{StaticResource DataGridCellStyle}" ElementStyle="{StaticResource DataTextStyle}" HeaderStyle="{StaticResource ColumnHeaderStyle}">

                    </DataGridTextColumn>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" IsReadOnly="True" CellStyle="{StaticResource DataGridCellStyle}" ElementStyle="{StaticResource DataTextStyle}" HeaderStyle="{StaticResource ColumnHeaderStyle}"></DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </Grid>
</UserControl>
