<UserControl x:Class="FSK.Sensitivity.Main.Views.SecondaryContrast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FSK.Sensitivity.Main.Views"
                          xmlns:hc="https://handyorg.github.io/handycontrol"
                  xmlns:prism="http://prismlibrary.com/"
prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" Name="对比度视标"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Background="{Binding BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.8*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <TextBlock  Foreground="{Binding TitleColor}" FontSize="{StaticResource subScreenhintFontSize}" Margin="80,0" TextAlignment="Center"  VerticalAlignment="Bottom" TextWrapping="Wrap" HorizontalAlignment="Center">
            <Run>请选择您能看清的编号最大的视标</Run>
            <LineBreak></LineBreak>
            <Run>并选择下方的按钮</Run>
        </TextBlock>

        <Border Grid.Row="1">
            <Border.Background>
                <ImageBrush RenderOptions.BitmapScalingMode="HighQuality"  Stretch="Uniform" ImageSource="{Binding SignImage}">

                </ImageBrush>
            </Border.Background>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <UniformGrid  Grid.Column="1" Rows="2"  Background="Red" >
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=1}" Content="1"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=2}" Content="2"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=3}" Content="3"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=4}" Content="4"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=5}" Content="5"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=6}" Content="6"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=7}" Content="7"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=8}" Content="8"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=9}" Content="9"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
                <RadioButton GroupName="SelectSign" IsChecked="{Binding SelectedIndex,Converter={StaticResource RadioButonCheckedConverter},ConverterParameter=10}" Content="10"   Style="{StaticResource SignToggleButtonBaseStyle}"/>
            </UniformGrid>
        </Grid>
        
    </Grid>
</UserControl>
