<UserControl x:Class="FSK.Sensitivity.Main.Controls.Pagination"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FSK.Sensitivity.Main.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="550">
    <UserControl.Resources>
        <Style x:Key="txtStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- 上一页按钮 -->
            <Button x:Name="btnPrevious" 
                    Content="上一页" 
                    Style="{StaticResource NavButton}"
                    Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, 
                                    Path=PreviousCommand}"/>

            <!-- 页码显示 -->
            <TextBlock VerticalAlignment="Center" 
                       Margin="20,0,5,0" Style="{StaticResource txtStyle}"
                       Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, 
                                     Path=CurrentPage}"/>

            <TextBlock VerticalAlignment="Center" 
                       Text="/" Style="{StaticResource txtStyle}"
                       Margin="0,0,5,0"/>

            <TextBlock VerticalAlignment="Center" 
                       Margin="0,0,20,0" Style="{StaticResource txtStyle}"
                       Text="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, 
                                     Path=TotalPages}"/>

            <!-- 下一页按钮 -->
            <Button x:Name="btnNext" 
                    Content="下一页" 
                   Style="{StaticResource NavButton}"
                    Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, 
                                    Path=NextCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
